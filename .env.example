# =============================================================================
# LLM-v2 Environment Variables Configuration
# =============================================================================
# 
# Copy this file to .env and fill in your actual API keys and configuration
# 
#   cp .env.example .env
#   # Then edit .env with your actual values
#
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Choose at least one OpenAI provider
# -----------------------------------------------------------------------------

# Azure OpenAI (Recommended for RAG backend - default)
# Used for: RAG backend (document processing, embeddings, responses)
# Get your key at: https://portal.azure.com/
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/

# Standard OpenAI (Required for --openai-tools backend or as fallback)
# Used for: OpenAI native tools backend, or fallback if Azure not configured
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Model Configuration (overrides config.py defaults)
# -----------------------------------------------------------------------------

# Model configuration (format: "model,reasoning_effort,text_verbosity")
# Examples:
#   OPENAI_MODEL_CONFIG=gpt-5-mini,medium,medium
#   OPENAI_MODEL_CONFIG=gpt-5,high,high
# Supported models: gpt-5, gpt-5-mini, gpt-5-nano
# Reasoning effort: low, medium, high
# Text verbosity: low, medium, high
# OPENAI_MODEL_CONFIG=

# High-end model configuration (for quality mode)
# OPENAI_MODEL_HIGH_CONFIG=gpt-5,high,high

# Individual model settings (alternative to combined format above)
# OPENAI_MODEL=gpt-5-mini
# REASONING_EFFORT=medium
# TEXT_VERBOSITY=medium

# High-end model individual settings
# OPENAI_MODEL_HIGH=gpt-5
# REASONING_EFFORT_HIGH=high
# TEXT_VERBOSITY_HIGH=high

# Embedding model (for RAG backend)
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# EMBEDDING_MODEL=text-embedding-3-large

# Similarity threshold for deduplication (0.0 to 1.0)
# SIMILARITY_THRESHOLD=0.8

# -----------------------------------------------------------------------------
# OPTIONAL: LlamaParse Configuration (for high-quality document parsing)
# -----------------------------------------------------------------------------

# LlamaParse API key (for better PDF/table extraction)
# Get your key at: https://cloud.llamaindex.ai/
# Free tier: 1000 pages/day
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Optional: LlamaParse base URL (for European endpoint or custom endpoints)
# Default: https://api.cloud.llamaindex.ai
# Use European endpoint for GDPR compliance:
# LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai

# Optional: Azure OpenAI key for LlamaParse multimodal model
# Only needed if using Azure OpenAI with LlamaParse (configured in config.py)
# LLAMA_PARSE_AZURE_OPENAI_KEY=your_azure_key_for_llamaparse

# -----------------------------------------------------------------------------
# OPTIONAL: Web Search (Tavily)
# -----------------------------------------------------------------------------

# Tavily API key (for web search capabilities)
# Get your key at: https://tavily.com/
# Free tier available
TAVILY_API_KEY=your_tavily_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Reranking (Cohere)
# -----------------------------------------------------------------------------

# Cohere API key (for result reranking to improve relevance)
# Get your key at: https://cohere.com/
# Free tier available
# Alternative: CO_API_KEY (also supported)
COHERE_API_KEY=your_cohere_api_key_here
# CO_API_KEY=your_cohere_api_key_here  # Alternative name

# -----------------------------------------------------------------------------
# OPTIONAL: Qdrant Configuration (if using custom Qdrant setup)
# -----------------------------------------------------------------------------

# Qdrant connection settings (defaults: localhost:6333)
# Only needed if using non-default Qdrant instance
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_api_key  # Only for Qdrant Cloud

# =============================================================================
# Notes:
# =============================================================================
#
# 1. Minimum Required:
#    - Either AZURE_OPENAI_API_KEY + AZURE_OPENAI_BASE_URL
#      OR OPENAI_API_KEY
#
# 2. Recommended Optional:
#    - LLAMA_CLOUD_API_KEY (for better document parsing)
#    - TAVILY_API_KEY (for web search)
#    - COHERE_API_KEY (for result reranking)
#
# 3. Configuration Priority:
#    - Environment variables override config.py defaults
#    - Command-line arguments override environment variables
#
# 4. Security:
#    - Never commit .env file to version control
#    - .env is already in .gitignore
#    - Keep your API keys secure
#
# =============================================================================
